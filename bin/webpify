#!/usr/bin/env bash
# img2webp — Compress PNG/JPG → WebP using sharp-cli, with optional downscale
# Usage: img2webp [OPTIONS]
#   -q, --quality NUM      WebP quality 1-100       (default: 80)
#   -e, --effort NUM       Compression effort 0-9   (default: 6)
#   -m, --max-res WxH      Max resolution, e.g. 1920x1080  (default: 1920x1080)
#       --no-resize        Disable automatic resizing
#   -d, --delete           Delete originals after conversion
#   -r, --recursive        Also process subdirectories
#   -h, --help             Show this help

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────────
QUALITY=80
EFFORT=6
MAX_W=1920
MAX_H=1080
RESIZE=true
DELETE_ORIGINALS=false
RECURSIVE=false

# ── Parse arguments ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    -q|--quality)   QUALITY="$2";          shift 2 ;;
    -e|--effort)    EFFORT="$2";           shift 2 ;;
    -m|--max-res)
      IFS='xX' read -r MAX_W MAX_H <<< "$2"
      if [[ -z "$MAX_W" || -z "$MAX_H" ]]; then
        echo "Error: --max-res expects WxH, e.g. 1920x1080" >&2; exit 1
      fi
      shift 2 ;;
    --no-resize)    RESIZE=false;          shift   ;;
    -d|--delete)    DELETE_ORIGINALS=true; shift   ;;
    -r|--recursive) RECURSIVE=true;        shift   ;;
    -h|--help)
      sed -n '2,10p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# ── Sanity checks ────────────────────────────────────────────────────────────
if ! command -v sharp &>/dev/null; then
  echo "Error: 'sharp' CLI not found. Install with: npm i -g sharp-cli" >&2
  exit 1
fi

# ── Collect input files ─────────────────────────────────────────────────────
shopt -s nullglob nocaseglob

if $RECURSIVE; then
  files=( ./**/*.png ./**/*.jpg ./**/*.jpeg ./*.png ./*.jpg ./*.jpeg )
else
  files=( ./*.png ./*.jpg ./*.jpeg )
fi

shopt -u nocaseglob

# Deduplicate
declare -A seen
unique_files=()
for f in "${files[@]}"; do
  [[ -f "$f" ]] || continue
  real="$(realpath "$f")"
  if [[ -z "${seen[$real]+_}" ]]; then
    seen[$real]=1
    unique_files+=("$f")
  fi
done

if [[ ${#unique_files[@]} -eq 0 ]]; then
  echo "No PNG/JPG images found in the current directory."
  exit 0
fi

echo "Found ${#unique_files[@]} image(s)."
echo "  → WebP  q=$QUALITY  effort=$EFFORT"
$RESIZE && echo "  → Max resolution: ${MAX_W}×${MAX_H} (downscale only)"
echo ""

# ── Build the resize portion of the sharp command ────────────────────────────
RESIZE_ARGS=()
if $RESIZE; then
  # fit inside  = scale down to fit within WxH, preserve aspect ratio, no crop
  # withoutEnlargement = never upscale smaller images
  RESIZE_ARGS=( -- resize "$MAX_W" "$MAX_H" --fit inside --withoutEnlargement )
fi

# ── Process each image ───────────────────────────────────────────────────────
converted=0
skipped=0
failed=0

for src in "${unique_files[@]}"; do
  name="$(basename "${src%.*}")"
  dir="$(dirname "$src")"
  dest="${dir}/${name}.webp"

  # Skip if webp already exists and is newer than source
  if [[ -f "$dest" && "$dest" -nt "$src" ]]; then
    ((skipped++)) || true
    continue
  fi

  if sharp \
    -i "$src" \
    -o "$dest" \
    -f webp \
    -q "$QUALITY" \
    --effort "$EFFORT" \
    --smartSubsample \
    "${RESIZE_ARGS[@]+"${RESIZE_ARGS[@]}"}" \
    2>/dev/null; then

    src_size=$(stat -c%s "$src" 2>/dev/null || stat -f%z "$src")
    dst_size=$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest")
    ratio=$(awk "BEGIN {printf \"%.0f\", (1 - $dst_size/$src_size) * 100}")

    printf "  ✓ %-40s %6s → %6s  (%s%% smaller)\n" \
      "$src" \
      "$(numfmt --to=iec-i --suffix=B "$src_size" 2>/dev/null || echo "${src_size}B")" \
      "$(numfmt --to=iec-i --suffix=B "$dst_size" 2>/dev/null || echo "${dst_size}B")" \
      "$ratio"

    if $DELETE_ORIGINALS; then
      rm -- "$src"
    fi

    ((converted++)) || true
  else
    echo "  ✗ $src (conversion failed)" >&2
    ((failed++)) || true
  fi
done

# ── Summary ──────────────────────────────────────────────────────────────────
echo ""
echo "Done: $converted converted, $skipped skipped (up-to-date), $failed failed."
$DELETE_ORIGINALS && [[ $converted -gt 0 ]] && echo "Original files deleted."
