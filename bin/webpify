#!/usr/bin/env bash
# webpify — Compress PNG/JPG → WebP using sharp-cli, with optional downscale
# Usage: webpify [OPTIONS]
#   -q, --quality NUM      WebP quality 1-100       (default: 80)
#   -e, --effort NUM       Compression effort 0-9   (default: 6)
#   -m, --max-res WxH      Max resolution, e.g. 1920x1080  (default: 1920x1080)
#       --no-resize        Disable automatic resizing
#   -d, --delete           Delete originals after conversion
#   -r, --recursive        Also process subdirectories
#   -w, --watch            Watch for new/changed files and convert on the fly
#   -h, --help             Show this help

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────────
QUALITY=80
EFFORT=6
MAX_W=1920
MAX_H=1080
RESIZE=true
DELETE_ORIGINALS=false
RECURSIVE=false
WATCH=false

# ── Parse arguments ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    -q|--quality)   QUALITY="$2";          shift 2 ;;
    -e|--effort)    EFFORT="$2";           shift 2 ;;
    -m|--max-res)
      IFS='xX' read -r MAX_W MAX_H <<< "$2"
      [[ -z "$MAX_W" || -z "$MAX_H" ]] && {
        echo "Error: --max-res expects WxH" >&2; exit 1; }
      shift 2 ;;
    --no-resize)    RESIZE=false;          shift   ;;
    -d|--delete)    DELETE_ORIGINALS=true; shift   ;;
    -r|--recursive) RECURSIVE=true;        shift   ;;
    -w|--watch)     WATCH=true;            shift   ;;
    -h|--help)      sed -n '2,13p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# ── Sanity checks ────────────────────────────────────────────────────────────
command -v sharp &>/dev/null || {
  echo "Error: 'sharp' CLI not found. npm i -g sharp-cli" >&2; exit 1; }

# ── Resize args (built once) ─────────────────────────────────────────────────
RESIZE_ARGS=()
if $RESIZE; then
  RESIZE_ARGS=( -- resize "$MAX_W" "$MAX_H" --fit inside --withoutEnlargement )
fi

# ── Convert a single file ────────────────────────────────────────────────────
convert_one() {
  local src="$1"
  local name dir dest
  name="$(basename "${src%.*}")"
  dir="$(dirname "$src")"
  dest="${dir}/${name}.webp"

  # Skip if webp is already newer
  if [[ -f "$dest" && "$dest" -nt "$src" ]]; then
    return 0
  fi

  if sharp \
      -i "$src" -o "$dest" \
      -f webp -q "$QUALITY" --effort "$EFFORT" --smartSubsample \
      "${RESIZE_ARGS[@]+"${RESIZE_ARGS[@]}"}" \
      2>/dev/null; then

    local src_size dst_size ratio
    src_size=$(stat -c%s "$src" 2>/dev/null || stat -f%z "$src")
    dst_size=$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest")
    ratio=$(awk "BEGIN {printf \"%.0f\", (1-$dst_size/$src_size)*100}")

    printf "  ✓ %-40s %6s → %6s  (%s%% smaller)\n" \
      "$src" \
      "$(numfmt --to=iec-i --suffix=B "$src_size" 2>/dev/null || echo "${src_size}B")" \
      "$(numfmt --to=iec-i --suffix=B "$dst_size" 2>/dev/null || echo "${dst_size}B")" \
      "$ratio"

    $DELETE_ORIGINALS && rm -- "$src"
  else
    echo "  ✗ $src (conversion failed)" >&2
    return 1
  fi
}

# ── Batch mode (original behaviour) ──────────────────────────────────────────
run_batch() {
  shopt -s nullglob nocaseglob
  local files
  if $RECURSIVE; then
    files=( ./**/*.png ./**/*.jpg ./**/*.jpeg ./*.png ./*.jpg ./*.jpeg )
  else
    files=( ./*.png ./*.jpg ./*.jpeg )
  fi
  shopt -u nocaseglob

  # deduplicate
  declare -A seen
  local unique_files=()
  for f in "${files[@]}"; do
    [[ -f "$f" ]] || continue
    local real; real="$(realpath "$f")"
    [[ -n "${seen[$real]+_}" ]] && continue
    seen[$real]=1
    unique_files+=("$f")
  done

  [[ ${#unique_files[@]} -eq 0 ]] && {
    echo "No PNG/JPG images found."; return 0; }

  echo "Found ${#unique_files[@]} image(s)."
  for src in "${unique_files[@]}"; do
    convert_one "$src" || true
  done
}

# ── Watch mode ────────────────────────────────────────────────────────────────
run_watch() {
  # Pick the watcher
  local watcher=""
  if command -v inotifywait &>/dev/null; then
    watcher="inotifywait"
  elif command -v fswatch &>/dev/null; then
    watcher="fswatch"
  else
    echo "Error: --watch requires inotify-tools (Linux) or fswatch." >&2
    echo "  apt install inotify-tools   # or: brew install fswatch" >&2
    exit 1
  fi

  echo "Watching for PNG/JPG changes… (Ctrl-C to stop)"
  echo "  → WebP  q=$QUALITY  effort=$EFFORT"
  $RESIZE && echo "  → Max resolution: ${MAX_W}×${MAX_H}"
  $DELETE_ORIGINALS && echo "  → Originals will be deleted after conversion"
  echo ""

  if [[ "$watcher" == "inotifywait" ]]; then
    # -m  = monitor (don't exit after one event)
    # -r  = recursive (only if requested)
    # We watch close_write (finished saving) and moved_to (drag-and-drop / mv)
    local inotify_flags=(-m -e close_write -e moved_to --format '%w%f')
    $RECURSIVE && inotify_flags+=(-r)

    inotifywait "${inotify_flags[@]}" . 2>/dev/null | \
    while IFS= read -r filepath; do
      # Filter to image extensions (case-insensitive)
      case "${filepath,,}" in
        *.png|*.jpg|*.jpeg)
          [[ -f "$filepath" ]] && convert_one "$filepath" || true
          ;;
      esac
    done

  elif [[ "$watcher" == "fswatch" ]]; then
    local fswatch_flags=(-0 --event Created --event Updated --event MovedTo)
    $RECURSIVE && fswatch_flags+=(-r)

    fswatch "${fswatch_flags[@]}" . | \
    while IFS= read -r -d '' filepath; do
      case "${filepath,,}" in
        *.png|*.jpg|*.jpeg)
          [[ -f "$filepath" ]] && convert_one "$filepath" || true
          ;;
      esac
    done
  fi
}

# ── Main ──────────────────────────────────────────────────────────────────────
if $WATCH; then
  # Process existing files first, then watch for new ones
  run_batch
  echo ""
  run_watch
else
  run_batch
fi